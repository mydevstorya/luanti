# Android SDK location (auto-generated by Android Studio)
sdk.dir=C:\\path\\to\\Android\\Sdk

# Keystore for release signing (optional)
#keystore=../user.keystore
#keystore.password=your_password
#key=your_key_alias
#key.password=your_key_password

# === YooKassa Payment Configuration ===
# Get these values from YooKassa dashboard: https://yookassa.ru/my/shop-settings

# Backend API URLs for payment processing
yookassa.backend_url_debug=https://payments-debug.moodray.ru
yookassa.backend_url_prod=https://payments.moodray.ru

# Shop IDs (from YooKassa dashboard)
yookassa.shop_id_debug=your_debug_shop_id
yookassa.shop_id_prod=your_prod_shop_id

# Client Application Keys (from YooKassa dashboard -> Settings -> SDK keys)
yookassa.client_key_debug=test_your_debug_client_key
yookassa.client_key_prod=live_your_prod_client_key
